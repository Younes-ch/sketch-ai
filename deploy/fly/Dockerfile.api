# ── Build stage ──
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Copy project files for restore (layer cache)
COPY Directory.Packages.props .
COPY global.json .
COPY src/SketchAI.ServiceDefaults/SketchAI.ServiceDefaults.csproj src/SketchAI.ServiceDefaults/
COPY src/SketchAI.Api/SketchAI.Api.csproj src/SketchAI.Api/

RUN dotnet restore src/SketchAI.Api/SketchAI.Api.csproj

# Copy source and publish
COPY src/SketchAI.ServiceDefaults/ src/SketchAI.ServiceDefaults/
COPY src/SketchAI.Api/ src/SketchAI.Api/

RUN dotnet publish src/SketchAI.Api/SketchAI.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# ── Runtime stage ──
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app
COPY --from=build /app/publish .
COPY deploy/fly/entrypoint-api.sh .
RUN chmod +x entrypoint-api.sh

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["./entrypoint-api.sh"]
