# Build stage
FROM node:22-slim AS build
WORKDIR /app

# Copy package files from the frontend directory
COPY src/SketchAI.Web/package*.json ./

# Install dependencies
RUN npm ci

# Copy source files
COPY src/SketchAI.Web/ .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Copy custom nginx config template
COPY src/SketchAI.Web/nginx.conf /etc/nginx/templates/default.conf.template

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy runtime config script that injects environment variables
COPY src/SketchAI.Web/docker-entrypoint.d/20-envsubst-config.sh /docker-entrypoint.d/20-envsubst-config.sh
RUN chmod +x /docker-entrypoint.d/20-envsubst-config.sh

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
