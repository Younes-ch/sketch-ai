{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameSettings": {
    "DefaultMaxPlayers": 8,
    "DefaultRounds": 3,
    "DefaultDrawTime": 80,
    "DefaultWordChoices": 3,
    "DefaultDifficulty": "mixed"
  },
  "RateLimiterCleanup": {
    // CleanupInterval: minutes between cleanup runs
    "CleanupInterval": 10,
    // IdleThreshold: hours of inactivity before a limiter is removed
    "IdleThreshold": 1
  }
}
